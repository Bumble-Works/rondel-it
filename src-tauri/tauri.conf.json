{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Rondel It",
  "version": "0.1.0",
  "identifier": "com.bumbleworks.rondelit",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rondel It",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "backgroundThrottling": "disabled"
      },
      {
        "label": "reminder",
        "title": "Reminder",
        "width": 460,
        "height": 300,
        "minWidth": 360,
        "minHeight": 200,
        "resizable": true,
        "minimizable": false,
        "maximizable": false,
        "center": true,
        "visible": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
